{
  "name": "@austin/pm-sandbox",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "npm run clean:next && next dev -p 3000",
    "dev:stable": "npm run clean:next && next dev -p 3000",
